# ── CrisisSync: copy to .env.local (and .env for setup scripts) ───────────

# SUPABASE POSTGRESQL
# Runtime: Supabase Dashboard → Connect → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Schema setup: direct/session connection (port 5432).
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_POOL_SIZE=3

# PRIVATE SUPABASE STORAGE — server-only service role, never NEXT_PUBLIC.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=crisissync-evidence

# FREE WEB PUSH — generate with: npx tsx scripts/generate-vapid.ts
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Public-route quota hashing. Use a long random value (32+ characters).
RATE_LIMIT_SALT=

# Google AI Studio → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Real Open-Meteo fallback already works without a key.
OPENWEATHER_API_KEY=

# Optional: one harmless number displayed for seeded volunteers. No SMS is sent.
DEMO_SMS_PHONE=+910000000000

# LOCAL VS CODE FALLBACK (use instead of the Supabase URLs above)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# DATABASE_SSL=false
